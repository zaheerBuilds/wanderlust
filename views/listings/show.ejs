<% layout("layouts/boilerplate") %>

<div class="container my-5" style="max-width: 600px">
  <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
    <!-- Back Link -->
    <a href="/listings" class="text-decoration-none fw-bold" style="color: #ff385c">
      &lt;- Back to all listings
    </a>

    <!-- Title -->
    <h1 class="text-dark text-start mt-4 fs-2"><%= listing.title %></h1>

    <!-- Image -->
    <img
      src="<%= listing.image.url %>"
      alt="<%= listing.title %>"
      class="w-100 my-3 rounded-4 object-fit-cover"
      style="height: 350px"
    />

    <!-- Description -->
    <p class="fs-5 text-secondary-emphasis lh-base">
      <%= listing.description %>
    </p>

    <!-- Price -->
    <p class="fs-5 mt-4">
      <strong>Price:</strong> $<%= listing.price %> / night
    </p>

    <!-- Location -->
    <p class="text-muted">
      📌 Location: <%= listing.location %>, <%= listing.country %>
    </p>

    <!-- Action Buttons -->
    <% if(currUser && currUser._id.equals(listing.author._id)) { %>
      <div class="d-flex justify-content-around mt-3">
        <form action="/listings/<%=listing._id%>/edit" method="get">
          <button type="submit" class="btn btn-warning px-4">
            Edit Listing
          </button>
        </form>
        
        <form action="/listings/<%=listing._id%>?_method=DELETE" method="post">
          <button type="submit" class="btn btn-danger px-4 text-white">
            Delete Listing
          </button>
        </form>
      </div>
    <% } %>

    <!-- Reviews Section -->
    <div class="mt-4">
      <h5 class="mb-3">Reviews</h5>

      <% if (listing.reviews && listing.reviews.length > 0) { %>
        <!-- Wrap items in a Bootstrap row to align side-by-side -->
        <div class="row g-2">
          <% listing.reviews.forEach(review => { %>
            <!-- col-6 displays 2 items per line; small font utility (small / fs-7) added -->
            <div class="col-6">
              <div class="border border-light-subtle bg-light rounded p-2 h-100 small">
                <!-- User & Stars side-by-side inside the card -->
                <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap">
                  <strong class="text-truncate" style="max-width: 80px;">@<%= review.author.username %></strong>
                  <span class="text-warning small" style="font-size: 0.75rem;">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <% if (i <= review.rating) { %>
                        <i class="bi bi-star-fill"></i>
                      <% } else { %>
                        <i class="bi bi-star"></i>
                      <% } %>
                    <% } %>
                  </span>
                </div>

                <!-- Comment text -->
                <p class="mb-2 text-secondary text-break" style="font-size: 0.85rem; line-height: 1.2;">
                  <%= review.comment %>
                </p>

                <!-- Delete Review Button -->
                <form action="/listings/<%= listing._id %>/review/<%= review._id %>?_method=DELETE" method="POST" class="d-block text-end">
                  <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" style="font-size: 0.75rem;">
                    <i class="bi bi-trash"></i> Delete
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="border border-light-subtle rounded p-3 bg-light">
          <p class="mb-0 text-muted small">No reviews yet.</p>
        </div>
      <% } %>
    </div>

    <!-- Leave a Review Form -->
    <% if(currUser) { %>
      <div class="mt-4">
      <form action="/listings/<%=listing._id%>/review" method="post">
        <!-- Star Rating -->
        <div class="mb-3">
          <label class="form-label d-block">Your Rating</label>
          <div class="star-rating">
            <input type="radio" id="star5" name="rating" value="5">
            <label for="star5" class="bi bi-star"></label>

            <input type="radio" id="star4" name="rating" value="4">
            <label for="star4" class="bi bi-star"></label>

            <input type="radio" id="star3" name="rating" value="3">
            <label for="star3" class="bi bi-star"></label>

            <input type="radio" id="star2" name="rating" value="2">
            <label for="star2" class="bi bi-star"></label>

            <input type="radio" id="star1" name="rating" value="1">
            <label for="star1" class="bi bi-star"></label>
          </div>
        </div>
        
        <!-- Comment Input -->
        <div class="mb-3">
          <label for="comment" class="form-label">Your Comment</label>
          <textarea
            class="form-control"
            id="comment"
            rows="3"
            placeholder="What did you think about this listing?"
            required
            name="comment"
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-sm">
          Submit Review
        </button>
      </form>
    </div>
    <% } else { %>
      <div class="mt-3">
      <a href="/login?redirect=/listings/<%=listing._id%>" class="btn btn-primary btn-sm">
        Login to add reviews
      </a>
    </div>
    <% } %> 
      
  </div>
</div>
