<% layout("layouts/boilerplate") %>

    <header>
        <h1>All Listings</h1>
    </header>

    <main class="listings-container">
        <% for(let listing of listings) { %>
            <a href="listings/<%=listing._id%>">
              <div class="card">
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="card-img">
                <div class="card-body">
                    <h3><%= listing.title %></h3>
                    <p class="location">📌 <%= listing.location %>, <%= listing.country %></p>
                    <p class="price"><strong>$<%= listing.price.toLocaleString("en-US") %></strong> / night</p>
                </div>
            </div>
            </a>
        <% } %>
    </main>
